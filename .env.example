# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_ci
DB_USER=postgres
DB_PASSWORD=your_password_here

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=customer_intelligence

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Data Paths
DATA_PATH=./data
MODELS_PATH=./models

# Model Configuration
DEFAULT_MODEL_VERSION=1.0
CLV_PREDICTION_MONTHS=12

# Causal Inference
CAUSAL_EFFECT_CONFIDENCE=0.95

# Dashboard
DASHBOARD_PORT=8501

# YOLO Evaluation
EVAL_PROJECT_NAME=yolo-retail-intelligence
EVAL_EXPERIMENT_NAME=model_evaluation
EVAL_OUTPUT_DIR=evaluation_output
EVAL_DATASET_DIR=data

# YOLO Inference
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu
